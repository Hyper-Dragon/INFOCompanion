# Copy to .env and fill in. `.env` is gitignored: the key never enters the repo.

# Required for the companion to think, for whatever OpenAI-compatible endpoint
# agent-config.json names. Without it the game still plays, and the companion connects,
# says plainly that it has no key, and stays quiet.
INFOCOMPANION_LLM_API_KEY=

# The older name for the same key. Still read, for one release, and the companion's log
# says so when it is what carried the key.
# DEEPSEEK_API_KEY=

# Host port for SSH. Inside the container the daemon always listens on 2222.
INFOCOMPANION_HOST_PORT=2223

# Which game to boot into. Blank means: the last one played, else the first
# story file found in ./games.
INFOCOMPANION_GAME=

# Player credentials (the documented defaults, unchanged).
INFOCOMPANION_AUTH_USER=player
INFOCOMPANION_AUTH_PASSWORD=letsplay

# Auto-save every N turns; 0 disables it.
INFOCOMPANION_AUTOSAVE_TURNS=5

# Turn-framing quiescence window, in milliseconds (§7).
INFOCOMPANION_TURN_TIMEOUT_MS=400

# Serve the game with no companion at all — useful for isolating problems.
INFOCOMPANION_NO_AGENT=false

# What your companion is called is not a variable in this file: it is the `name:` in the front
# matter of the personality file below — the name in the panes, the login its pane answers to
# (`ssh james@…`), and the name the agent is told. `INFOCOMPANION_AGENT_NAME` only says what to
# call it *before* a personality has been read, and Docker Compose does not forward it, so setting
# it has no effect on a container. Rename in the file.
# Which personality, by slug: drop Assets/prompts/persona/<slug>.txt in and the name comes with it.
INFOCOMPANION_PERSONA=james
# What the companion calls the person at the keyboard, and how they are referred to. Preferred
# pronouns rather than a gender: it is the thing the companion actually needs, and the default is
# neutral on purpose.
INFOCOMPANION_PLAYER_NAME=Peter
INFOCOMPANION_PLAYER_PRONOUNS=He/Him

# The voice the companion's words are read aloud in is **not named here**. A voice belongs to a
# character, so it is the `voice:` key in the front matter of the personality file above: swap the
# personality and the voice comes with it, which is the whole point of the character being a file
# (C61). With nothing named there is no voice at all — no switch on the page, and a silent
# companion nobody asked to be silent.
#
# What a deployment says is *where* it is spoken. Blank means the browser's own voice reads the
# lines, which is a supported evening and costs the container nothing. Set it to the base of an
# endpoint answering the OpenAI speech shape (`POST /v1/audio/speech`) and that endpoint speaks
# instead, and `docker compose --profile voice up -d` starts the reference endpoint this project
# is tested against (not required, not supported — a place to point at while you decide where
# yours runs).
INFOCOMPANION_VOICE_URL=
# What that endpoint calls its model, and the rate it answers at. Both are passed through untouched:
# neither is a fact about INFOCompanion, and these two are what the reference endpoint uses.
INFOCOMPANION_VOICE_MODEL=kokoro
INFOCOMPANION_VOICE_RATE=24000
# How fast it says it: a multiplier on whatever the endpoint calls normal, and **1.0 sends no field at
# all** — a deployment with no opinion speaks to the endpoint on exactly that shape, and one that
# sets a speed is asking for the extension. A rate is a fact about a *voice*, so
# it differs per voice and per engine: measure yours rather than copying this. 1.3 is the reference
# pair, and it is arithmetic rather than taste — the voice says ~195 words a minute at 1.0, the page
# writes at 240 (`INFOCOMPANION_PACE_MEDIUM`), and 240/195 is why this region is the right one. It is
# **not a linear multiplier**: 1.3 measured at 1.18x less audio, which puts the voice at ~230-240 wpm —
# near the pace rather than a quarter of a line behind it.
INFOCOMPANION_VOICE_SPEED=1.3
# The companion's own pronouns. Leave blank to say nothing about them.
INFOCOMPANION_AGENT_PRONOUNS=He/Him

# Colours in the panes. `auto` (default) colours a real terminal and leaves pipes and
# scripts plain; `always` colours everything; `never` is plain text.
INFOCOMPANION_COLORS=auto

# Which colour each kind of line gets, as an ANSI SGR value. Leave a line blank (or
# delete it) for the default, or set it to `off` for no colour at all.
#   commands: "north", "save advent" — what Quill typed into the game
#   speech:   Quill talking to you
#   thought:  Quill's reasoning, shown by /think
#   notice:   the harness talking: checkpoints, connection events
#   prompt:   the ">>" in your typing pane
#   player:   your own words, as Quill's pane shows them back to you
# Values are digits and semicolons only — anything else is ignored, because this line
# ends up on your terminal.
INFOCOMPANION_COLOR_COMMAND=36
INFOCOMPANION_COLOR_SPEECH=1;37
INFOCOMPANION_COLOR_THOUGHT=90
INFOCOMPANION_COLOR_NOTICE=33
INFOCOMPANION_COLOR_PROMPT=1;32
INFOCOMPANION_COLOR_PLAYER=1;35

# How fast the words arrive (`S35`–`S40`): veryslow | slow | medium | fast | veryfast. The
# rates are words a minute, and 0 means as fast as it comes; `veryfast` is what the daemon did
# before the ladder existed. The level is where a session with no page to remember one starts,
# and the ceiling is the longest a turn may take to arrive however long it is. Blank means the
# default in docker-compose.yml (medium, 240 wpm). Blank is also safe *only* through Compose:
# clap has no "blank means default" for a number, so a rate left empty in the environment of a
# bare `cargo run` is a parse error rather than a default.
INFOCOMPANION_PACE=
INFOCOMPANION_PACE_VERYSLOW=
INFOCOMPANION_PACE_SLOW=
INFOCOMPANION_PACE_MEDIUM=
INFOCOMPANION_PACE_FAST=
INFOCOMPANION_PACE_CEILING=

# The daemon's cadences, timers and queue depths are **not** listed here, because they are not
# meant to be set here: they live in `Assets/core-config.json`, the same arrangement the companion
# already has. The bridge's pane geometry is in `Assets/webui-config.json`. Both are mounted
# read-only over their seeded copies in `state/`, so there is one file to edit and it is in the
# repository — and each key is also an environment variable (`INFOCOMPANION_EXIT_GRACE_MS`,
# `INFOCOMPANION_PANE_COLS`, …) for the case where a deployment really must win. Remember the rule
# above: leave a variable *out* rather than setting it to nothing, or a bare `cargo run` will
# refuse to start.

# trace | debug | info | warn | error
RUST_LOG=info
